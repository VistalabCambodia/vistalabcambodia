{
  "name": "vistalab-cambodia-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run check:worker && vite build --base=./",
    "check:worker": "tsc --ignoreConfig --noEmit --target ES2022 --lib ES2022 --moduleResolution Bundler --module ESNext cloudflare/src/index.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "^4.151.0"
  }
}
